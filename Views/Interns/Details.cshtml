@model InternPortal.Models.Intern

@{
    ViewData["Title"] = "Intern Details";
}

<div class="container-fluid max-width-form mt-4">
    <div class="card border-0 shadow-sm p-4">
        <div class="card-body">
            <h2 class="card-title mb-4 text-primary"><i class="bi bi-person-badge me-2"></i>Intern Details</h2>
            <hr class="mb-4" />
            
            <div class="row mb-3">
                <div class="col-sm-4 text-muted font-weight-bold">Name:</div>
                <div class="col-sm-8 font-weight-bold text-dark">@Model.Name</div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-4 text-muted font-weight-bold">Contact:</div>
                <div class="col-sm-8 text-dark">@Model.Contact</div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-4 text-muted font-weight-bold">Mentor:</div>
                <div class="col-sm-8 text-dark">@(Model.Mentor?.Name ?? "Unassigned")</div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-4 text-muted font-weight-bold">Department:</div>
                <div class="col-sm-8 text-dark">@Model.Department</div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-4 text-muted font-weight-bold">Branch:</div>
                <div class="col-sm-8 text-dark">@Model.Branch</div>
            </div>

            <div class="row mb-4">
                <div class="col-sm-4 text-muted font-weight-bold">Duration (Months):</div>
                <div class="col-sm-8 text-dark">@Model.DurationMonths Months</div>
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary px-4 rounded-pill"><i class="bi bi-pencil me-1"></i>Edit</a>
                <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">Back to List</a>
            </div>
        </div>
    </div>
</div>
