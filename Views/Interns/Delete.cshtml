@model InternPortal.Models.Intern

@{
    ViewData["Title"] = "Delete Intern";
}

<div class="container-fluid max-width-form mt-4">
    <div class="card border-0 shadow-sm p-4 border-danger-top">
        <div class="card-body">
            <h2 class="card-title mb-3 text-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i>Delete Intern</h2>
            <h5 class="text-muted mb-4">Are you sure you want to delete this intern's record? This action cannot be undone.</h5>
            <hr class="mb-4" />
            
            <div class="row mb-3">
                <div class="col-sm-4 text-muted font-weight-bold">Name:</div>
                <div class="col-sm-8 font-weight-bold text-dark">@Model.Name</div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-4 text-muted font-weight-bold">Contact:</div>
                <div class="col-sm-8 text-dark">@Model.Contact</div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-4 text-muted font-weight-bold">Mentor:</div>
                <div class="col-sm-8 text-dark">@(Model.Mentor?.Name ?? "Unassigned")</div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-4 text-muted font-weight-bold">Department:</div>
                <div class="col-sm-8 text-dark">@Model.Department</div>
            </div>

            <div class="row mb-3">
                <div class="col-sm-4 text-muted font-weight-bold">Branch:</div>
                <div class="col-sm-8 text-dark">@Model.Branch</div>
            </div>

            <div class="row mb-4">
                <div class="col-sm-4 text-muted font-weight-bold">Duration:</div>
                <div class="col-sm-8 text-dark">@Model.DurationMonths Months</div>
            </div>

            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger px-4 rounded-pill"><i class="bi bi-trash me-1"></i>Delete Permanently</button>
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 rounded-pill">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
