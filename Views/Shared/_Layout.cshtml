<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - InternPortal</title>
    
    <!-- Google Fonts: Poppins -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Custom site.css -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/InternPortal.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex flex-column flex-md-row min-vh-100">
        <!-- Sidebar -->
        <nav class="sidebar flex-shrink-0 p-4 text-white">
            <div class="d-flex align-items-center mb-4">
                <i class="bi bi-shield-fill-check fs-2 me-2 text-warning"></i>
                <h3 class="h4 mb-0 font-weight-bold tracking-wider">IOCL Portal</h3>
            </div>
            <hr class="border-light mb-4" />
            <ul class="nav nav-pills flex-column mb-auto gap-2">
                <li class="nav-item">
                    <a href="/" class="nav-link text-white d-flex align-items-center gap-2 @(Context.Request.Path == "/" ? "active" : "")">
                        <i class="bi bi-speedometer2"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Interns" class="nav-link text-white d-flex align-items-center gap-2 @(Context.Request.Path.StartsWithSegments("/Interns") ? "active" : "")">
                        <i class="bi bi-people"></i>
                        <span>Interns</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a href="/Attendance" class="nav-link text-white d-flex align-items-center gap-2 @(Context.Request.Path.StartsWithSegments("/Attendance") ? "active" : "")">
                        <i class="bi bi-calendar-check"></i>
                        <span>Attendance</span>
                    </a>
                </li>
            </ul>
            <div class="mt-auto pt-4 text-center font-size-sm opacity-75">
                &copy; 2026 IOCL
            </div>
        </nav>

        <!-- Main Content Area -->
        <main class="flex-grow-1 p-4 p-md-5 content-area">
            @RenderBody()
        </main>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
