@model List<InternPortal.Controllers.AttendanceRowViewModel>

@{
    ViewData["Title"] = "Daily Attendance";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="text-dark font-weight-bold"><i class="bi bi-calendar-check-fill text-primary me-2"></i>Daily Attendance</h1>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Date Selection Card -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row align-items-center g-3">
            <div class="col-md-4">
                <label for="date" class="form-label font-weight-bold text-muted mb-1">Select Attendance Date</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-calendar-event text-muted"></i></span>
                    <input type="date" id="date" name="date" value="@ViewBag.SelectedDate" class="form-control" onchange="this.form.submit()" />
                </div>
            </div>
            <div class="col-md-8 text-md-end pt-md-4">
                <span class="text-muted"><i class="bi bi-info-circle me-1"></i>Changing the date will automatically load records for that day.</span>
            </div>
        </form>
    </div>
</div>

<!-- Attendance Form -->
<form method="post" asp-action="Save">
    <input type="hidden" name="date" value="@ViewBag.SelectedDate" />
    
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Intern Name</th>
                            <th>Department</th>
                            <th>Branch</th>
                            <th class="text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">No interns registered yet. Please add interns first in the Directory.</td>
                            </tr>
                        }
                        else
                        {
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                <tr>
                                    <td class="ps-4 font-weight-bold text-dark">
                                        <input type="hidden" name="models[@i].InternId" value="@Model[i].InternId" />
                                        <input type="hidden" name="models[@i].InternName" value="@Model[i].InternName" />
                                        
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-circle-sm bg-secondary text-white me-2">
                                                @Model[i].InternName.Substring(0, Math.Min(Model[i].InternName.Length, 1)).ToUpper()
                                            </div>
                                            @Model[i].InternName
                                        </div>
                                    </td>
                                    <td>@Model[i].Department</td>
                                    <td>@Model[i].Branch</td>
                                    <td class="text-center">
                                        <div class="form-check form-switch d-inline-block">
                                            <input class="form-check-input attendance-switch" type="checkbox" name="models[@i].IsPresent" value="true" @(Model[i].IsPresent ? "checked" : "") />
                                            <label class="form-check-label text-muted ms-1">Present</label>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    
    @if (Model.Any())
    {
        <div class="d-flex justify-content-end mb-5">
            <button type="submit" class="btn btn-primary px-5 py-2.5 rounded-pill shadow-sm"><i class="bi bi-cloud-arrow-up-fill me-2"></i>Save Daily Attendance</button>
        </div>
    }
</form>
